{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../../distribution/windows/runtime/": "runtime/",
      "../../../distribution/windows/demo/": "runtime/demo/",
      "../../../distribution/windows/INSTALL.zh-TW.md": "docs/INSTALL.zh-TW.md"
    },
    "externalBin": [
      "binaries/fabdev-agent",
      "binaries/fabdev-windows-helper"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "windows/installer.nsi"
      }
    }
  }
}
